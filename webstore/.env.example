VITE_ALGOLIA_APP_ID=your_algolia_application_id
VITE_ALGOLIA_SEARCH_API_KEY=your_search_only_api_key
VITE_ALGOLIA_BADGES_INDEX=BADGES
VITE_API_BASE_URL=http://localhost:8765

# Build-only catalogue source. Never prefix these credentials with VITE_.
CATALOGUE_API_URL=https://example.org/api/catalogue
CATALOGUE_BASIC_AUTH_USERNAME=your_username
CATALOGUE_BASIC_AUTH_PASSWORD=your_password

# Optional local source for CoreData development; production builds use the API above.
# DISTRICT_CORE_DATA_LOCAL_PATH=/path/to/DistrictCoreData/data
